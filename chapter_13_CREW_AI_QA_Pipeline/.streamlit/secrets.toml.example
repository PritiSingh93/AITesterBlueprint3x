# Copy to .streamlit/secrets.toml for Streamlit Community Cloud, or paste the
# contents into the app's Secrets box in the Streamlit dashboard.
# .streamlit/secrets.toml is gitignored. Never commit real values.

LLM_MODEL = ""
LLM_API_KEY = ""
LLM_BASE_URL = ""
LLM_TEMPERATURE = "0.1"

JIRA_INTEGRATION_MODE = "rest"
JIRA_URL = "https://your-domain.atlassian.net"
JIRA_AUTH_MODE = "basic"
JIRA_EMAIL = ""
JIRA_API_TOKEN = ""
JIRA_API_VERSION = "3"
JIRA_ACCEPTANCE_CRITERIA_FIELD = ""

# Streamlit Community Cloud cannot spawn a local stdio MCP subprocess, so use
# rest mode there, or point at a remote MCP server over streamable_http.
JIRA_MCP_TRANSPORT = "streamable_http"
JIRA_MCP_URL = ""
JIRA_MCP_GET_ISSUE_TOOL = ""

PIPELINE_MAX_TICKETS = "20"
PIPELINE_TICKET_TIMEOUT_SECONDS = "600"
LOG_LEVEL = "INFO"
DEMO_MODE = "false"

# Copy to .env and fill in. Never commit the real .env.

APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs

# ---------------------------------------------------------------------------
# LLM. The model id is configurable on purpose: provider naming changes, and a
# hard-coded literal becomes a silent production failure.
# Examples:
#   Groq      LLM_MODEL=openai/openai/gpt-oss-120b  LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI    LLM_MODEL=gpt-4o-mini
#   Anthropic LLM_MODEL=anthropic/claude-sonnet-5
# ---------------------------------------------------------------------------
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4800
# Reasoning models (gpt-oss, o-series, DeepSeek-R1) bill internal thinking
# against the output budget, which can truncate JSON mid-structure. Set "low"
# to reclaim that budget. Leave empty for models without a reasoning mode.
LLM_REASONING_EFFORT=low
# Per-request ceiling counting prompt + max_tokens together. Groq's free tier
# enforces 8000 and returns 413 above it. Set it and every agent's output
# budget is clamped to (limit - prompt reserve). Leave 0 to disable clamping.
LLM_TPM_LIMIT=8000
LLM_PROMPT_RESERVE=3200

# ---------------------------------------------------------------------------
# Jira. auto = try MCP, fall back to REST. mcp / rest force one provider.
# ---------------------------------------------------------------------------
JIRA_INTEGRATION_MODE=auto
JIRA_URL=https://your-domain.atlassian.net
JIRA_AUTH_MODE=basic
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20
JIRA_REST_TIMEOUT_SECONDS=30
JIRA_KEY_PATTERN=^[A-Z][A-Z0-9_]+-\d+$

# ---------------------------------------------------------------------------
# Jira MCP. stdio spawns a local server; streamable_http / sse call a remote one.
# Tool naming differs between MCP servers, so it is configurable rather than
# assumed. Leave JIRA_MCP_GET_ISSUE_TOOL empty to auto-detect from the allowlist.
#
# stdio example (mcp-atlassian via uvx):
#   JIRA_MCP_TRANSPORT=stdio
#   JIRA_MCP_COMMAND=uvx
#   JIRA_MCP_ARGS_JSON=["mcp-atlassian"]
# ---------------------------------------------------------------------------
JIRA_MCP_TRANSPORT=stdio
JIRA_MCP_URL=
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS_JSON=[]
JIRA_MCP_HEADERS_JSON={}
JIRA_MCP_ENV_JSON={}
JIRA_MCP_GET_ISSUE_TOOL=
JIRA_MCP_ISSUE_KEY_ARG=issue_key
JIRA_MCP_ALLOWED_TOOLS=jira_get_issue,getJiraIssue,get_issue
JIRA_MCP_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
PIPELINE_MAX_TICKETS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_TICKET_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO

# Demo mode reads tickets from fixtures/jira/*.json. It must be enabled
# explicitly and is never an automatic fallback for a failed integration.
DEMO_MODE=false

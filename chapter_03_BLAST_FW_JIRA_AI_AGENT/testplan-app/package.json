{
  "name": "testplan-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js --watch server\" \"cd client && npm run dev\"",
    "start": "node server/index.js",
    "install:client": "cd client && npm install",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^2.0.22"
  }
}

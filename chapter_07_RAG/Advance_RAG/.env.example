# Copy to .env and fill in your own key.
GROQ_API_KEY=your_groq_api_key_here          # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b

EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DENSE_DIM=1024
BGE_USE_FP16=1
# RAG_LITE=1        # uncomment to run without downloading the heavy models

QDRANT_PATH=./qdrant_data
# QDRANT_URL=http://127.0.0.1:6333
COLLECTION_NAME=vwo_test_cases

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_N_HYBRID=20
TOP_K_RERANK=4
RRF_K=60
REWRITE_ENABLED=1
N_REWRITES=3
INGEST_BATCH=32

HOST=127.0.0.1
PORT=5050

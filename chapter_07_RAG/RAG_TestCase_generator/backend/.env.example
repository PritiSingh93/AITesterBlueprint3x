# Groq API (LLM test case generation) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Mistral AI API (embeddings) - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-embed

# Paths - relative paths are resolved against the backend/ folder
DATA_DIR=../data
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=langflow_ai3x_TC

# Chunking (characters) - matches the Langflow SplitText node
CHUNK_TARGET_CHARS=1000
CHUNK_OVERLAP_CHARS=200

# Retrieval - matches the Langflow Chroma node's number_of_results
TOP_K=10

PORT=8000

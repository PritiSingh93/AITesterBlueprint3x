# Groq API (LLM answer generation) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Nomic Atlas API (embeddings) - https://atlas.nomic.ai
NOMIC_API_KEY=your_nomic_api_key_here
NOMIC_MODEL=nomic-embed-text-v1.5

# Paths - relative paths are resolved against the backend/ folder
DATA_DIR=../data
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=rag_explorer_docs

# Chunking targets (characters; ~4 chars per token)
CHUNK_TARGET_CHARS=3200
CHUNK_OVERLAP_CHARS=400

# Retrieval
TOP_K=4

PORT=8000

# OCR fallback (only used when a PDF has no extractable text layer at all).
# Leave blank if Tesseract/Poppler are already on your PATH.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
TESSERACT_CMD=
POPPLER_PATH=
OCR_DPI=200

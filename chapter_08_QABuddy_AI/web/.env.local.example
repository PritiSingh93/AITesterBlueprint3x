# Copy to .env.local for local dev. These are SERVER-SIDE only (never exposed to
# the browser) because the API routes run on the server and proxy to the backend.

# Base URL of the FastAPI backend.
#   Local dev (backend reachable via nginx on port 80):  http://localhost/api
#   Production (droplet, Phase B, HTTPS + domain):        https://api.your-domain.com
BACKEND_URL=http://localhost/api

# Shared secret sent to the backend as the X-QAB-Key header. Leave blank for now;
# fill it in once Phase B adds the API-key check to backend/main.py.
BACKEND_KEY=

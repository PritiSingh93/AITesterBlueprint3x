# Copy to .env and fill in. NEVER commit .env.

# --- LLM ------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Services (docker-compose service names; use localhost for local dev) --
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION=qabuddy
TEI_EMBED_URL=http://tei-embed:80
TEI_RERANK_URL=http://tei-rerank:80

# --- Hybrid sparse side ---------------------------------------------------
# bm25 (default, fastembed) | tei (SPLADE model on TEI_SPARSE_URL/embed_sparse)
SPARSE_BACKEND=bm25
#TEI_SPARSE_URL=

# --- JIRA via MCP (owner provides) ----------------------------------------
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
JIRA_MCP_SEARCH_TOOL=searchJiraIssuesUsingJql

# --- Tuning ---------------------------------------------------------------
TOP_N_HYBRID=20
TOP_K_RERANK=8
INGEST_BATCH=32

# --- Frontend -------------------------------------------------------------
BACKEND_URL=http://backend:8000
